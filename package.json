{
  "name": "react-native-practice",
  "version": "0.1.0",
  "private": true,
  "main": "index.js",
  "packageManager": "pnpm@10.20.0",
  "engines": { "node": ">=22.16.0" },
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "android:release": "expo run:android --variant release",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "node --experimental-strip-types --test tests/core.test.ts",
    "test:ui": "jest --runInBand",
    "test:sql": "python3 tests/sqlite_test.py",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm test:ui && pnpm test:sql",
    "doctor": "expo-doctor",
    "export:android": "expo export --platform android --output-dir dist/android",
    "export:web": "expo export --platform web --output-dir dist/web",
    "check:android": "bash scripts/check-android.sh"
  },
  "dependencies": {
    "expo": "57.0.29",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-web": "0.21.0",
    "expo-router": "57.0.27",
    "expo-linking": "57.0.13",
    "expo-constants": "57.0.22",
    "expo-status-bar": "57.0.1",
    "expo-splash-screen": "57.0.10",
    "expo-system-ui": "57.0.4",
    "expo-font": "57.0.4",
    "expo-dev-client": "57.0.20",
    "expo-modules-core": "57.0.23",
    "expo-sqlite": "57.0.4",
    "expo-haptics": "57.0.3",
    "expo-speech": "57.0.3",
    "expo-notifications": "57.0.23",
    "expo-background-task": "57.0.21",
    "expo-task-manager": "57.0.21",
    "expo-network": "57.0.2",
    "expo-updates": "57.0.26",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "4.26.0",
    "react-native-gesture-handler": "2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-worklets": "0.10.1",
    "@expo/vector-icons": "15.0.2",
    "@tanstack/react-query": "5.90.2",
    "@sentry/react-native": "7.11.0"
  },
  "devDependencies": {
    "typescript": "6.0.3",
    "@types/react": "19.2.2",
    "@types/node": "22.16.0",
    "eslint": "9.39.1",
    "eslint-config-expo": "57.0.2",
    "prettier": "3.6.2",
    "jest": "29.7.0",
    "jest-expo": "57.0.6",
    "@types/jest": "29.5.14",
    "@testing-library/react-native": "13.3.3",
    "react-test-renderer": "19.2.3",
    "expo-doctor": "1.20.4",
    "@react-native/jest-preset": "0.86.3"
  },
  "expo": { "autolinking": { "nativeModulesDir": "./modules" } }
}
